# Server
NUXT_PORT=8000

# Database
DATABASE_PATH=./data/db/espie.db

# Node.js memory limit (for Pi 4)
NODE_OPTIONS=--max-old-space-size=512

# Timezone offset in hours from UTC (for OTA response)
TZ_OFFSET_HOURS=0

# ASR (Speech-to-Text)
GROQ_API_KEY=gsk_your_key_here

# LLM
ANTHROPIC_API_KEY=sk-ant-your_key_here
LLM_MODEL=claude-sonnet-4-20250514

# TTS
TTS_VOICE=en-US-AriaNeural
